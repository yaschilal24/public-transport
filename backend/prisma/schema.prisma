generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum TransportType {
  BUS
  METRO
  TRAIN
  TRAM
  FERRY
}

enum RouteStatus {
  ACTIVE
  SUSPENDED
  MAINTENANCE
}

enum ReportCategory {
  DELAY
  DAMAGED_VEHICLE
  UNSAFE_CONDITION
  INCORRECT_INFO
  MISSING_STOP
  OTHER
}

enum ReportStatus {
  PENDING
  UNDER_REVIEW
  RESOLVED
  REJECTED
}

enum AlertSeverity {
  LOW
  MEDIUM
  HIGH
  CRITICAL
}

enum AlertStatus {
  ACTIVE
  EXPIRED
  SCHEDULED
}

enum NotificationType {
  ALERT
  ROUTE_CHANGE
  REPORT_UPDATE
  ANNOUNCEMENT
}

model User {
  id           String   @id @default(cuid())
  fullName     String
  email        String   @unique
  phone        String?
  passwordHash String
  profileImage String?
  role         Role     @default(USER)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  favorites    Favorite[]
  reports      Report[]
  notifications Notification[]
  deviceTokens DeviceToken[]

  @@index([email])
}

model Route {
  id                String        @id @default(cuid())
  routeNumber       String        @unique
  routeName         String
  description       String?
  startLocation     String
  endLocation       String
  transportType     TransportType
  estimatedDuration Int
  fare              Decimal?      @db.Decimal(10, 2)
  status            RouteStatus   @default(ACTIVE)
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  routeStops   RouteStop[]
  schedules    Schedule[]
  favorites    Favorite[]
  reports      Report[]
  serviceAlerts ServiceAlert[]

  @@index([routeNumber])
  @@index([routeName])
  @@index([transportType])
  @@index([status])
}

model Stop {
  id          String   @id @default(cuid())
  stopName    String
  description String?
  latitude    Float
  longitude   Float
  address     String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  routeStops    RouteStop[]
  reports       Report[]
  serviceAlerts ServiceAlert[]

  @@index([latitude, longitude])
  @@index([stopName])
}

model RouteStop {
  id        String @id @default(cuid())
  routeId   String
  stopId    String
  stopOrder Int

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)
  stop  Stop  @relation(fields: [stopId], references: [id], onDelete: Cascade)

  @@unique([routeId, stopId])
  @@unique([routeId, stopOrder])
  @@index([stopId])
}

model Schedule {
  id            String   @id @default(cuid())
  routeId       String
  departureTime String
  arrivalTime   String
  operatingDays String
  frequency     Int?
  scheduleType  String   @default("DEMO")

  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@index([routeId])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  routeId   String
  createdAt DateTime @default(now())

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route @relation(fields: [routeId], references: [id], onDelete: Cascade)

  @@unique([userId, routeId])
  @@index([userId])
}

model Report {
  id          String         @id @default(cuid())
  userId      String
  routeId     String?
  stopId      String?
  category    ReportCategory
  description String
  imageUrl    String?
  latitude    Float?
  longitude   Float?
  status      ReportStatus   @default(PENDING)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt

  user  User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  route Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  stop  Stop?  @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([status])
}

model ServiceAlert {
  id             String        @id @default(cuid())
  title          String
  description    String
  severity       AlertSeverity
  routeId        String?
  stopId         String?
  startDate      DateTime
  expirationDate DateTime?
  status         AlertStatus   @default(ACTIVE)
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt

  route Route? @relation(fields: [routeId], references: [id], onDelete: SetNull)
  stop  Stop?  @relation(fields: [stopId], references: [id], onDelete: SetNull)

  @@index([status])
  @@index([severity])
}

model Notification {
  id        String           @id @default(cuid())
  userId    String
  title     String
  message   String
  type      NotificationType
  isRead    Boolean          @default(false)
  createdAt DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, isRead])
}

model DeviceToken {
  id            String   @id @default(cuid())
  userId        String
  expoPushToken String   @unique
  platform      String
  createdAt     DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}